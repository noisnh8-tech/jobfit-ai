# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 git에 올라가지 않습니다.
#
# 공개 데모(JOBFIT_MODE=demo, 기본값)로만 볼 거라면 아래 키는 필요 없습니다 -
# 데모는 LLM을 실제로 호출하지 않고 사전 계산된 예시 결과만 보여줍니다.
# 본인 이력서/공고로 실제 분석을 돌리고 싶을 때만(JOBFIT_MODE=local) 아래를 채우세요.

# 운영 모드 여부. local 로 설정해야 실제 jobs.db + 실제 LLM 호출을 씁니다.
# 값을 아예 안 주거나 "demo"로 두면 항상 데모 모드로 실행됩니다.
JOBFIT_MODE=demo

# Gemini (1순위 provider)
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=

# Claude (Gemini 실패 시 폴백)
ANTHROPIC_API_KEY=
